@media(min-width:768px) and (orientation: landscape){

    form{
        max-width: 30rem ;
    }

    body{
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        min-height: 100vh;
    }

    form{
        max-width: 25rem;
    }

    #imgD{
        width: 22%;
        height: fit-content;
        
    }

    input[type="submit"]{
        align-self: left;
        width: 100%;
    }

    #linhaD{
        position: fixed;
        height: 25vw;
        width: 0.5px;
        border-radius: 25px;
        background-color: black;
    }

    h1{
        text-align: left;
    }

}

@media(min-width: 1200px){

    body{
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        min-height: 100vh;
    }

    form{
        max-width: 25rem;
        transform: translateX(50%);
    }

    #imgD{
        width: 22.17%;
        height: fit-content;
        position: fixed;
        top: 55.2%;
        transform: translateY(-70.1%);
        left: 9.59%;
    }

    input[type="submit"]{
        align-self: left;
        width: 100%;
    }

    #linhaD{
        position: fixed;
        height: 25vw;
        width: 0.5px;
        border-radius: 25px;
        background-color: black;
        top: 55.1%;
        transform: translateY(-60%);
        left: 50.99%;
    }

    h1{
        text-align: left;
    }

}